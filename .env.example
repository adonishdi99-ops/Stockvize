# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# From Meta's App Dashboard > WhatsApp > API Setup
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Any string you choose; must match the verify token you enter in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=pick_any_string_yourself

# The vendor's own WhatsApp number, digits only, no '+'
VENDOR_PHONE=2348012345678
